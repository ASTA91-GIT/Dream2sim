# ==============================================================================
# DREAM2SIM CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env or backend/.env and add your private credentials.
# ==============================================================================

# Meta Model API Credentials
META_API_KEY=your_meta_api_key_here
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# Backward-compatible model key alias
MODEL_API_KEY=

# Meta Models
MUSE_SPARK_MODEL=muse-spark-1.3
MUSE_WONDER_MODEL=muse-wonder
MUSE_IMAGE_MODEL=muse-image
MUSE_VOICE_MODEL=muse-voice-transcribe
SAM_MODEL=sam-3.1

# Security & App Secrets
SECRET_KEY=dream2sim-super-secret-development-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL in production; SQLite supported for zero-config local dev)
DATABASE_URL=sqlite+aiosqlite:///./dream2sim.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dream2sim

# Redis Cache & Task Broker (Optional for basic local dev; memory fallback included)
REDIS_URL=redis://localhost:6379/0

# Network & URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
